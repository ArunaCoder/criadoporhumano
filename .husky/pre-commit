#!/bin/sh
set -e

echo "📦 Verificando node_modules indevidos..."
extra_modules=$(find . -path './node_modules' -prune -o -type d -name node_modules -print)
if [ -n "$extra_modules" ]; then
  echo "🛑 Pastas node_modules indevidas encontradas. Use apenas a RAIZ."
  exit 1
fi

echo "🔍 Rodando Gitleaks..."
gitleaks protect --staged --verbose --log-level=error

# 🦀 Validação Rust (descomentrar quando criar backend)
# echo "🦀 Validando Rust (Clippy & Fmt)..."
# cargo fmt --all -- --check
# cargo clippy -- -D warnings

echo "⚠️ TypeScript BYPASSADO (apenas backend em desenvolvimento)"
# echo "🕵️ Verificando tipos com TypeScript..."
# npx tsc -b

echo ""

# echo "🔄 Verificando dependências circulares..."
node scripts/check-cycles.mjs

echo "📏 Verificando tamanho de arquivos..."
bash scripts/file-length.sh

echo "✅ Pre-commit concluído com sucesso!"
