{
  "name": "criadoporhumano",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo - Análise Biométrica de Autoria",
  "workspaces": [
    "frontend",
    "sdk",
    "browser-extension"
  ],
  "scripts": {
    "dev": "npm run dev -w frontend",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "check-cycles": "node scripts/check-cycles.mjs",
    "check-cycles:verbose": "node scripts/check-cycles.mjs --verbose",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,json,md}": "biome check --write --no-errors-on-unmatched"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@types/node": "^25.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
